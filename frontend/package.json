  "scripts": {
    "predev": "node scripts/ensureViteInstalled.mjs",
    "prestart": "node scripts/ensureViteInstalled.mjs",
    "dev": "vite",
    "start": "vite --host 0.0.0.0 --port 3000",
    "check:architecture": "node scripts/checkArchitecture.mjs",
    "prebuild": "node scripts/checkArchitecture.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
